{
  "name": "Albolsillo",
  "short_name": "Albolsillo",
  "description": "Tus finanzas personales, al bolsillo.",
  "lang": "es-AR",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0B0F",
  "theme_color": "#0A0B0F",
  "icons": [
    {
      "src": "assets/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Cargar gasto",
      "url": "/?nuevo=gasto",
      "icons": [
        {
          "src": "assets/brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Gastos detectados",
      "url": "/?ver=detectados",
      "icons": [
        {
          "src": "assets/brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}